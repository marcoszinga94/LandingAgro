---
const coche1: HTMLElement | null = document.getElementById("coche1");
const coche2: HTMLElement | null = document.getElementById("coche2");

let x_coche1: number = 0;
let x_coche2: number = 0;

function correr(): void {
    if (x_coche1 <= 85 && x_coche1 >= 0) {
        x_coche1 = x_coche1 + 2;
        if (coche1) {
            coche1.style.left = x_coche1 + "%";
        }
    } else {
        x_coche1 = 0;
        if (coche1) {
            coche1.style.left = x_coche1 + "%";
        }
    }

    // Movimiento coche2
    if (x_coche2 <= 85 && x_coche2 >= 0) {
        x_coche2 = x_coche2 + 1;
        if (coche2) {
            coche2.style.left = x_coche2 + "%";
        }
    } else {
        x_coche2 = 0;
        if (coche2) {
            coche2.style.left = x_coche2 + "%";
        }
    }
}

---

<!DOCTYPE html>
<html>
<head lang="es">
    <meta charset="UTF-8">
    <title>Carrera</title>
</head>
<body>
    <div class="body">
	<img id="tractor1" src="tractor.png" alt="Este es mi tractor">
	<img id="tractor2" src="tractor1.png" alt="Este es mi oponente">			
	<div class="zona_boton">
		<input
        type="button"
        @click='correr'
        value="A CORRER!">	
	</div>
    </div>
</body>
</html>
