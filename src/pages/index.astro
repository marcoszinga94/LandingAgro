---
import Layout from "../layouts/Layout.astro";
import Encabezado from "../components/Encabezado.astro";
import Nosotros from "../components/Nosotros.astro";
import Servicios from "../components/Servicios&Equipos.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Produccion from "../components/Produccion.astro";
---

<Layout title="El Socorro">
  <Header />
  <main>
    <SectionContainer>
      <Encabezado />
    </SectionContainer>

    <SectionContainer class="bg-[#edeadd] md:max-h-screen flex-col md:flex-row" id="Nosotros">
      <Nosotros />
    </SectionContainer>

    <SectionContainer id="Servicios" class="">
      <Servicios />
    </SectionContainer>

    <SectionContainer id="Produccion" class="bg-[#243015] text-[#edeadd] flex-col">
      <Produccion />
    </SectionContainer>

    <SectionContainer id="Contacto" class="">
      <Contacto />
    </SectionContainer>

    <Footer />
  </main>
</Layout>
