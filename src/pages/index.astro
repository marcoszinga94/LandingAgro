---
import Layout from "../layouts/Layout.astro";
import Encabezado from "../components/Encabezado.astro";
import Nosotros from "../components/Nosotros.astro";
import Servicios_Equipos from "../components/Servicios&Equipos.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Produccion from "../components/Produccion.astro";
import SectionContainer from "../components/SectionContainer.astro";
import NavegadorMovil from "../components/NavegadorMovil.astro";
import CotizacionDolar from "../components/CotizacionDolar.astro";
import Pronostico from "../components/Pronostico.astro";
import InstagramBanner from "../components/InstagramBanner.astro";
---

<Layout>
  <Header />
  <main>
    <SectionContainer>
      <Encabezado />
    </SectionContainer>

    <SectionContainer id="Nosotros" class="flex-col md:flex-row lg:h-screen bg-[#edeadd]">
      <Nosotros />
    </SectionContainer>

    <SectionContainer id="Servicios" class="flex-col md:flex-row">
      <Servicios_Equipos />
    </SectionContainer>

    <SectionContainer id="Produccion" class="flex-col h-auto w-screen m-auto py-8 bg-[#243015] text-[#edeadd]">
      <Produccion />
    </SectionContainer>

    <SectionContainer>
      <InstagramBanner />
    </SectionContainer>

    <SectionContainer id="Contacto" class="flex-col md:flex-row justify-center m-auto p-auto h-auto md:h-[50vh] bg-[#edeadd]">
      <Contacto />
    </SectionContainer>

    <SectionContainer class="p-4 border-y-2 border-green-700 bg-white">
      <Pronostico />
      <CotizacionDolar />
    </SectionContainer>

    <Footer />
    <NavegadorMovil />
  </main>
</Layout>
