---
import Layout from "../layouts/Layout.astro";
import Encabezado from "../components/Encabezado.astro";
import Nosotros from "../components/Nosotros.astro";
import Servicios from "../components/Servicios&Equipos.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Produccion from "../components/Produccion.astro";
import SectionContainer from "../components/SectionContainer.astro";
---

<Layout title="El Socorro">
  <Header />
  <main>
    <SectionContainer>
      <Encabezado />
    </SectionContainer>
    <SectionContainer class="bg-[#edeadd] flex-col lg:flex-row" id="Nosotros">
      <Nosotros />
    </SectionContainer>
    <SectionContainer id="Servicios" class="flex-col lg:flex-row">
      <Servicios />
    </SectionContainer>
    <SectionContainer id="Produccion" class="bg-[#243015] text-white flex flex-col h-auto w-screen m-auto py-8">
      <Produccion />
    </SectionContainer>
    <SectionContainer id="Contacto" class="flex-col lg:flex-row">
      <Contacto />
    </SectionContainer>
  </main>
  <Footer />
</Layout>
