---
import Close from "./Close.astro";
---

<div id="menu-movil" class="[transform:translateY(-200%)] fixed top-0 left-0 w-full h-screen bg-[#EDEBE6] transition-transform duration-500 ease-in-out z-40">
    <div class="flex justify-end p-4">
        <Close id="close-menu-button" class="z-50" />
    </div>
    <nav class="flex flex-col items-center justify-center h-full -mt-16">
        <ul class="flex flex-col items-center gap-8">
            <li><a href="#top" class="text-2xl font-bold text-[#425630]">Inicio</a></li>
            <li><a href="#Nosotros" class="text-2xl font-bold text-[#425630]">Nosotros</a></li>
            <li><a href="#Servicios" class="text-2xl font-bold text-[#425630]">Servicios</a></li>
            <li><a href="#Contacto" class="text-2xl font-bold text-[#425630]">Contacto</a></li>
        </ul>
        <div class="flex gap-6 mt-12">
            <a
                title="Instagram"
                target="_blank"
                href="https://www.instagram.com/el_socorro_srl/"
            >
                <img src="/Icons/Instagram.svg" alt="Icono de Instagram" class="w-8 h-8" />
            </a>
            <a title="Whatsapp" target="_blank" href="https://wa.link/z416mm">
                <img src="/Icons/Whatsapp.svg" alt="Icono de Whatsapp" class="w-8 h-8" />
            </a>
        </div>
    </nav>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuMovil = document.getElementById("menu-movil");
        const closeMenuButton = document.getElementById("close-menu-button");

        if (menuMovil && closeMenuButton) {
            const links = menuMovil.querySelectorAll("a");

            const closeMenu = () => {
                menuMovil.classList.add("[transform:translateY(-200%)]");
            };

            closeMenuButton.addEventListener("click", closeMenu);

            links.forEach(link => {
                link.addEventListener("click", closeMenu);
            });
        }
    });
</script>
