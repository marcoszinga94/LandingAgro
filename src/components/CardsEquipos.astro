---
import CardsEquiposItems from "./CardsEquiposItems.astro";
const CARDSEQUIPOS = [
  {
    titulo: "Siembra",
    descripcion: {
      1: "1 John Deere 8400",
      2: "2 John Deere 8320",
      3: "3 John Deere 7R",
      4: "Crucianelli Plantor 42-38 + Presicion Planting",
      5: "John Deere DB 62 Exact emergy",
      6: "John Deere Airl drill 80 - 19",
      7: "Fercam 16 – 70 Manisera",
    },
    imagen: "./Images/siembra.webp",
  },
  {
    titulo: "Cosecha",
    descripcion: {
      1: "4 unidades John Deere S670",
      2: "1 unidad John Deere 780",
      3: "4 draper John Deere 40",
      4: "1 draper John Deere 45",
    },
    imagen: "./Images/cosecha.webp",
  },
  {
    titulo: "Pulverización",
    descripcion: "3 Stara Imperador 4000",
    imagen: "./Images/pulverizacion.webp",
  },
  {
    titulo: "Tecnología + Monitorización",
    descripcion: {
      1: "Precision Planting",
      2: "John Deere Conecta",
    },
    imagen: "./Images/precision.webp",
  },
];
---

<div class="flex flex-col">
  <div class="flex flex-col m-auto p-auto justify-between">
    <h2 class="text-4xl font-bold pb-6 text-center">Equipos</h2>
    <p class="text-center text-2xl py-4 px-8 md:px-10">
      En <span class="font-bold">El Socorro</span>, contamos con herramientas para tu campo.
    </p>
  </div>
  <ol class="grid grid-cols-2 gap-4 md:gap-8">
    {
      CARDSEQUIPOS.map((info) => (
        <li>
          <CardsEquiposItems {...info} />
        </li>
      ))
    }
  </ol>
</div>
