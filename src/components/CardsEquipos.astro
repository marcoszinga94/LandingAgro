---
const CARDSEQUIPOS = [
  {
    titulo: "Siembra",
    imagen: "./Images/siembra.webp",
    uno: "1 John Deere 8400",
    dos: "2 John Deere 8320",
    tres: "3 John Deere 7R",
    cuatro: "Crucianelli Plantor 42-38 + Presicion Planting",
    cinco: "John Deere DB 62 Exact emergy",
    seis: "John Deere Airl drill 80 - 19",
    siete: "Fercam 16 – 70 Manisera",
  },
  {
    titulo: "Cosecha",
    imagen: "./Images/cosecha.webp",
    uno: "4 unidades John Deere S670",
    dos: "1 unidad John Deere 780",
    tres: "4 draper John Deere 40",
    cuatro: "1 draper John Deere 45",
  },
  {
    titulo: "Pulverización",
    imagen: "./Images/pulverizacion.webp",
    uno: "3 Stara Imperador 4000",
  },
  {
    titulo: "Tecnología + Monitoreo",
    imagen: "./Images/precision.webp",
    uno: "Precision Planting",
    dos: "John Deere Conecta",
  },
];
---

<div class="flex flex-col">
  <div class="flex flex-col m-auto p-auto justify-between">
    <h2 class="text-4xl font-bold mt-0 md:m-auto px-auto pb-8 text-center">Equipos</h2>
    <p class="text-center text-2xl pb-4 px-8 md:px-10">En <span class="font-bold">El Socorro</span>, contamos con la mejor tecnología en maquinarias para:</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">
    {
      CARDSEQUIPOS.map((equipos) => (
      <div class="flex flex-col justify-between bg-[#243015] hover:scale-105 duration-300 shadow-lg rounded-lg m-0 p-0">
      <!-- Front -->
        <h2 class="text-[#edeadd] text-center font-semibold text-sm md:text-xl my-4">{equipos.titulo}</h2>
        <img loading="lazy" src={equipos.imagen} class="h-56 w-auto border-md object-cover rounded-b-md" alt="imagen del equipo" />
      <!-- Back -->
        <div class="rounded-md absolute inset-0 bg-black bg-opacity-70 text-white flex items-center justify-center opacity-0 transition-opacity duration-300 hover:opacity-100">
          <ul>
            <li>{equipos.uno}</li>
            <li>{equipos.dos}</li>
            <li>{equipos.tres}</li>
            <li>{equipos.cuatro}</li>
            <li>{equipos.cinco}</li>
            <li>{equipos.seis}</li>
            <li>{equipos.siete}</li>
          </ul>
        </div>
      </div>
      ))
    }
        
  </div>
</div>
