---
const CULTIVOS = [
  { nombre: "Maíz", imagen: "./Images/maiz.webp" },
  { nombre: "Soja", imagen: "./Images/soja.webp" },
  { nombre: "Girasol", imagen: "./Images/girasol.webp" },
  { nombre: "Trigo", imagen: "./Images/trigo.webp" },
  { nombre: "Cebada", imagen: "./Images/cebada.webp" },
  { nombre: "Centeno", imagen: "./Images/centeno.webp" },
  { nombre: "Maní", imagen: "./Images/mani.webp" },
  { nombre: "Sorgo", imagen: "./Images/sorgo.webp" },
];
---

<h2 class="text-4xl font-bold mt-0 md:m-auto px-auto pb-8 text-center">
  Producción
</h2>

<div
  class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 md:gap-16 m-8 md:m-auto pb-8"
>
  {
    CULTIVOS.map((cultivo) => (
      <div
        class="flex flex-col justify-between bg-[#edeadd] shadow-lg rounded-lg m-0 p-0 overflow-hidden"
      >
        <h3
          class="text-[#243015] text-sm md:text-xl text-center font-semibold my-4"
        >
          {cultivo.nombre}
        </h3>
        <img
          loading="lazy"
          src={cultivo.imagen}
          class="w-auto h-full min-h-[150px] max-h-[200px] border-md object-cover rounded-b-md"
          alt={`cultivo de ${cultivo.nombre}`}
        />
      </div>
    ))
  }
</div>
