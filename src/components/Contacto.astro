<section
  id="contacto"
  class="flex flex-col justify-center bg-white m-auto p-auto h-[50vh]"
>
  <h2 class="text-3xl font-bold text-center mb-6">Contacto</h2>
  <div class="flex flex-row">
    <div class="w-1/2 m-auto p-4 bg-green-400">
      <h3 class="text-xl font-bold text-center mb-6">Datos de contacto</h3>
      <p class="mb-2">Cale Imaginacion 123, Ciudad Verdadera, Argentina</p>
      <p class="mb-2">contacto@empresax.com</p>
      <p>+54(3456)15401234</p>
    </div>
    <div class="w-1/2 m-auto p-4">
      <h3 class="text-xl font-bold text-center mb-6">Formulario de contacto</h3>
      <form class="">
        <div class="grid grid-cols-3 gap-4 mb-4">
          <input
            type="text"
            name="nombre"
            placeholder="Nombre"
            class="border"
          />
          <input
            type="email"
            name="email"
            placeholder="Correo electrónico"
            class="border"
          />
          <input
            type="text"
            name="asunto"
            placeholder="Asunto"
            class="border"
          />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <textarea name="mensaje" placeholder="Mensaje" class="border"
          ></textarea>
          <button type="submit" class="border bg-green-400">Enviar</button>
        </div>
      </form>
    </div>
  </div>
</section>
