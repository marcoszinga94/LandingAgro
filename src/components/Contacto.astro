<section id="contacto" class="lg:max-w-full w-full m-auto p-0">
  <h2 class="text-center font-bold text-3xl m-4">Contacto</h2>
  <p class="text-center text-2xl m-4">
    ¡Contáctanos hoy para obtener más información!
  </p>
  <p class="text-center text-xl m-4">
    Estamos aquí para responder a tus preguntas y proporcionar la asistencia que
    necesitas.
  </p>

  <div
    class="flex flex-col justify-center w-full h-auto p-auto m-auto border lg:flex-row"
  >
    <aside
      class="flex items-center justify-center text-white font-bold bg-green-900 flex-1"
    >
      <div class="text-sm flex">
        <ul class="flex flex-col text-base list-none p-0">
          <li class="mb-4 flex flex-row">
            <svg
              class="h-4 w-4 mr-2"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 384 512"
            >
              <path
                d="M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"
              ></path>
            </svg>
             Calle Principal 123, Ciudad, País
          </li>
          <li class="mb-4 flex flex-row">
            <svg
              class="h-4 w-4 mr-2"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 512 512"
            >
              <path
                d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"
              ></path>
            </svg>
             +123 456 789
          </li>
          <li class="mb-4 flex flex-row">
            <svg
              class="h-4 w-4 mr-2"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 512 512"
            >
              <path
                d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"
              ></path>
            </svg>
             info@example.com
          </li>
        </ul>
      </div>
    </aside>

    <aside class="formulario bg-white flex-1">
      <form [formGroup]="formulario" (ngSubmit)="enviarFormulario()">
        <div class="flex flex-row p-2">
          <input
            type="text"
            id="nombre"
            placeholder="Nombre"
            class="w-full p-2 m-2 border border-gray-300 rounded bg-white"
          />
          <input
            type="text"
            id="telefono"
            placeholder="Teléfono"
            class="w-full p-2 m-2 border border-gray-300 rounded bg-white"
          />
          <input
            type="text"
            id="email"
            placeholder="Email"
            class="w-full p-2 m-2 border border-gray-300 rounded bg-white"
          />
        </div>
        <div class="flex flex-row p-2">
          <textarea
            id="mensaje"
            placeholder="Mensaje"
            class="w-full p-2 m-2 border border-gray-300 rounded bg-white"
          ></textarea>
          <button type="submit" class="p-2 m-2 bg-green-500 text-white rounded"
            >Enviar</button
          >
        </div>
      </form>
    </aside>
  </div>
</section>
