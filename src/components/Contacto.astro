<section id="contacto" class="flex justify-center m-auto p-auto h-[50vh]">
  <aside class="flex-1">
    <h2 class="text-3xl font-bold text-center mb-6">Contacto</h2>
    <div class="flex flex-row">
      <div class="w-1/2 m-auto p-4 bg-green-400 text-right">
        <h3 class="text-xl font-bold text-center mb-6">Datos de contacto</h3>
        <p class="mb-2">Cale Imaginacion 123, Ciudad Verdadera, Argentina</p>
        <p class="mb-2">elsocorro@gmail.com</p>
        <p>+54 9 3757 53 3256</p>
      </div>
    </div>
  </aside>
  <aside class="flex-1">
    <div class="w-1/2 m-auto p-4 bg-white">
      <h3 class="text-xl font-bold text-center mb-6">Formulario de contacto</h3>
      <form class="">
        <div class="grid grid-cols-3 gap-4 mb-4">
          <input
            type="text"
            name="nombre"
            placeholder="Nombre"
            class="border"
          />
          <input
            type="email"
            name="email"
            placeholder="Correo electrónico"
            class="border"
          />
          <input
            type="text"
            name="asunto"
            placeholder="Asunto"
            class="border"
          />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <textarea name="mensaje" placeholder="Mensaje" class="border"
          ></textarea>
          <button type="submit" class="border bg-green-400">Enviar</button>
        </div>
      </form>
    </div>
  </aside>
</section>
