<section
  id="contacto"
  class="flex flex-col justify-center m-auto p-auto h-auto md:h-[50vh]"
>
  <h2 class="text-3xl font-bold text-center my-6">Contacto</h2>
  <div class="flex flex-row m-0 p-0">
    <aside class="flex-1 mt-8 mx-auto md:m-auto h-auto w-full">
      <div class="flex flex-row">
        <div class="w-full m-auto p-8 bg-[#425630] text-white text-right">
          <h3 class="text-xl font-bold text-center mb-6">Datos de contacto</h3>
          <p class="mb-2">Cale Imaginacion 123, Ciudad Verdadera, Argentina</p>
          <p class="mb-2">elsocorro@gmail.com</p>
          <p class="mb-2">+54 9 3757 53 3256</p>
        </div>
      </div>
    </aside>
    <aside class="flex-1 mt-8 mx-auto md:m-auto">
      <div class="w-full m-auto p-8 bg-white">
        <h3 class="text-xl font-bold text-center mb-6">
          Formulario de contacto
        </h3>
        <form class="">
          <div class="grid grid-cols-3 gap-4 mb-4">
            <input
              type="text"
              name="nombre"
              placeholder="Nombre"
              class="border"
            />
            <input
              type="email"
              name="email"
              placeholder="Correo electrónico"
              class="border"
            />
            <input
              type="text"
              name="telefono"
              placeholder="Teléfono"
              class="border"
            />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <textarea name="mensaje" placeholder="Mensaje" class="border"
            ></textarea>
            <button type="submit" class="border bg-[#425630] text-white"
              >Enviar</button
            >
          </div>
        </form>
      </div>
    </aside>
  </div>
</section>
