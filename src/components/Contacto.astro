<section id="contacto" class="flex flex-col justify-center m-auto p-auto h-auto md:h-[50vh]">
  <!-- RESTO DEL CODIGO -->
  <h2 class="text-3xl font-bold text-center my-6">Contacto</h2>
  <div class="flex flex-row">
    <aside class="flex-1 my-8 mx-auto md:m-auto h-full">
      <div class="flex flex-row">
        <div class="w-full p-8 bg-[#425630] text-white">
          <h3 class="text-xl font-bold text-center mb-6">Datos de contacto</h3>
          <p class="mb-2">Cale Imaginacion 123, Ciudad Verdadera, Argentina</p>
          <p class="mb-2">elsocorro@gmail.com</p>
          <p class="mb-2">+54 9 3757 53 3256</p>
        </div>
      </div>
    </aside>
    <aside class="flex-1 my-8 mx-auto md:m-auto h-full">
      <div class="w-full p-8 bg-white">
        <h3 class="text-xl font-bold text-center mb-6">Formulario de contacto</h3>
        <form class="grid grid-cols-3 gap-4 mb-4">
          <input type="text" name="nombre" placeholder="Nombre" class="border" />
          <input type="email" name="email" placeholder="Correo electrónico" class="border" />
          <input type="text" name="telefono" placeholder="Teléfono" class="border" />
        </form>
        <div class="grid grid-cols-2 gap-4">
          <textarea name="mensaje" placeholder="Mensaje" rows="2" class="border"></textarea>
          <button type="submit" class="border bg-[#425630] text-white">Enviar</button>
        </div>
      </div>
    </aside>
  </div>
</section>
