---
const { titulo, descripcion, imagen } = Astro.props;
---

<div class="flex flex-col justify-between bg-white hover:scale-105 duration-300 shadow-lg rounded-lg m-0 p-0">
  <!-- Front -->
  <h2 class="text-black text-xl text-center font-semibold my-4">{titulo}</h2>
  <img loading="lazy" src={imagen} class="h-56 w-auto border-md object-cover rounded-b-md" alt="imagen del equipo" />
  <!-- Back -->
  <div
    class="rounded-md absolute inset-0 bg-black bg-opacity-70 text-white flex items-center justify-center opacity-0 transition-opacity duration-300 hover:opacity-100"
  >
    <ol>{descripcion}</ol>
  </div>
</div>
