---
import CotizacionDolar from "./CotizacionDolar.astro";
import Pronostico from "./Pronostico.astro";
---

<header class="bg-white text-[#243015] pt-2 sticky top-0 left-0 right-0 h-auto w-screen px-4">
  <div class="flex mx-auto justify-between items-center px-0 lg:px-4 lg-px-32">
    <img src="/Icons/logo.svg" title="logo el socorro" alt="logo el socorro" width="200px" height="100px" />

    <nav class="bg-white border-gray-200 hidden lg:flex">
      <ul class="hidden lg:flex flex-row p-auto m-auto justify-between gap-4">
        <li class="">
          <a href="#top" title="Inicio"><p class="hidden lg:flex hover:scale-105 duration-300 border border-green-950 px-2 py-1 rounded-lg">Inicio</p></a>
        </li>
        <li class="">
          <a href="#Nosotros" title="Nosotros"
            ><p class="hidden lg:flex hover:scale-105 duration-300 border border-green-950 px-2 py-1 rounded-lg">Nosotros</p></a
          >
        </li>
        <li class="">
          <a href="#Servicios" title="Servicios">
            <p class="hidden lg:flex hover:scale-105 duration-300 border border-green-950 px-2 py-1 rounded-lg">Servicios</p>
          </a>
        </li>
        <li class="">
          <a href="#Contacto" title="Contacto">
            <p class="hidden lg:flex hover:scale-105 duration-300 border border-green-950 px-2 py-1 rounded-lg">Contacto</p>
          </a>
        </li>

        <li class="">
          <a title="Instagram" target="_blank" href="https://www.instagram.com/el_socorro_srl/"
            ><p class="hidden lg:flex hover:scale-105 duration-300 border border-green-950 px-2 py-1 rounded-lg">Instagram</p></a
          >
        </li>

        <li class="">
          <a title="Whatsapp" target="_blank" href="https://wa.link/z416mm"
            ><p class="hidden lg:flex hover:scale-105 duration-300 border border-green-950 px-2 py-1 rounded-lg">Whatsapp</p></a
          >
        </li>
      </ul>
    </nav>

    <Pronostico />
  </div>
  <CotizacionDolar />
</header>
