---
import Menu from "./Menu.astro";
import NavegadorMovil from "./NavegadorMovil.astro";
---

<header id="myHeader">
  <div class="flex mx-auto justify-between items-center px-10">
    <a href="/">
      <img
        src="/Icons/logo.webp"
        title="Logo El Socorro"
        alt="Logo de El Socorro"
        width="200"
        height="100"
      />
    </a>

    <div class="lg:hidden">
      <Menu id="menu-button" />
    </div>

    <nav class="bg-inherit hidden lg:flex">
      <ul class="hidden lg:flex flex-row p-auto m-auto justify-between gap-6">
        <li>
          <a href="#top" title="Inicio" class="link"
            ><p
              class="hidden lg:flex hover:scale-110 duration-300 px-2 py-1 font-semibold text-[#425630] text-lg"
            >
              Inicio
            </p></a
          >
        </li>
        <li>
          <a href="#Nosotros" title="Nosotros" class="link"
            ><p
              class="hidden lg:flex hover:scale-110 duration-300 px-2 py-1 font-semibold text-[#425630] text-lg"
            >
              Nosotros
            </p></a
          >
        </li>
        <li>
          <a href="#Servicios" title="Servicios" class="link">
            <p
              class="hidden lg:flex hover:scale-110 duration-300 px-2 py-1 font-semibold text-[#425630] text-lg"
            >
              Servicios
            </p>
          </a>
        </li>
        <li>
          <a href="#Contacto" title="Contacto" class="link">
            <p
              class="hidden lg:flex hover:scale-110 duration-300 px-2 py-1 font-semibold text-[#425630] text-lg"
            >
              Contacto
            </p>
          </a>
        </li>

        <li>
          <a
            title="Instagram"
            target="_blank"
            href="https://www.instagram.com/el_socorro_srl/"
          >
            <img src="/Icons/Instagram.svg" alt="Icono de Instagram" />
          </a>
        </li>

        <li>
          <a title="Whatsapp" target="_blank" href="https://wa.link/z416mm">
            <img src="/Icons/Whatsapp.svg" alt="Icono de Whatsapp" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<NavegadorMovil />

<style>
  header {
    background-color: rgba(237, 235, 222, 0.6);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: auto;
    width: 100%;
    z-index: 10;
    padding: 12px 40px;
    transition: all 0.5s;  }

  .header-bg {
    background-color: rgba(237, 235, 222, 1);
    transition: all 0.3s;
  }

  .link {
    position: relative;
    transition: all 0.3s ease;
  }

  .link:before {
    background-color: #425630;
    bottom: 5px;
    content: "";
    height: 2px;
    left: 0;
    margin: 0 auto;
    opacity: 0;
    position: absolute;
    right: 0;
    transform: translateX(-50px);
    transition: all 0.3s ease;
    width: 75%;
  }

  .link:hover:before {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("myHeader") as HTMLElement;
    if (window.scrollY > 500) {
      header.classList.add("header-bg");
    } else {
      header.classList.remove("header-bg");
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    const menuButton = document.getElementById("menu-button");
    const menuMovil = document.getElementById("menu-movil");

    if (menuButton && menuMovil) {
      menuButton.addEventListener("click", () => {
        menuMovil.classList.remove("[transform:translateY(-200%)]");
      });
    }
  });
</script>
