<div class="flex flex-row justify-center content-center h-auto w-screen text-green-950 text-lg">
  <p>El tiempo en <span id="ciudad">Mi Ciudad</span> es de <span id="temperatura">00.0</span>°C</p>
</div>

<script>
  // Posicion del usuario
  function success(pos: any) {
    const crd = pos.coords;

    const apiKey = "b41230023d7d2118a4de7dfd86a9e3ca";
    const apiUrl = `https://api.openweathermap.org/data/2.5/weather?lat=${crd.latitude}&lon=${crd.longitude}&appid=${apiKey}&exclude=minutely,hourly,daily,alerts&units=metric&lang=es`;

    getWeatherData(apiUrl);
  }

  function error(err: any) {
    console.warn(`ERROR(${err.code}): ${err.message}`);
  }

  const options = {
    timeout: 5000,
    maximumAge: 0,
  };
  navigator.geolocation.getCurrentPosition(success, error, options);

  // Tiempo en ubicacion
  async function getWeatherData(apiUrl: string) {
    try {
      const response = await fetch(apiUrl);

      if (!response.ok) {
        throw new Error(`Error al obtener los datos: ${response.statusText}`);
      }

      const data = await response.json();
      console.log(data);

      updateHtmlElements(data.name, data.main.temp);
    } catch (error) {
      console.error("Error:", error.message);
    }
  }

  function updateHtmlElements(ciudadName: string, temperatura: any) {
    const ciudadElement = document.getElementById("ciudad");
    const tempElement = document.getElementById("temperatura");

    if (ciudadElement) {
      ciudadElement.innerText = `${ciudadName}`;
    }
    if (tempElement) {
      tempElement.innerText = `${temperatura.toFixed(1)}`;
    }
  }
</script>
