<div
  class="flex flex-row justify-center content-center h-auto w-full text-green-950 text-lg"
>
  <p class="text-sm md:text-base">
    El tiempo en <span id="ciudad">Mi Ciudad</span> es de <span id="temperatura"
      >00.0</span
    >°C
  </p>
</div>

<script>
  const apiKey = "b41230023d7d2118a4de7dfd86a9e3ca";
  const apiUrl = (lat: number, lon: number) =>
    `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric&lang=es`;

  // Posicion del usuario
  function success(pos: any) {
    const crd = pos.coords;
    getWeatherData(apiUrl(crd.latitude, crd.longitude));
  }

  function error(err: any) {
    console.warn(`ERROR(${err.code}): ${err.message}`);
    // Ubicación por defecto: Alejandro Roca, Córdoba
    getWeatherData(apiUrl(-33.3543, -63.7277));
  }

  const options = {
    timeout: 5000,
    maximumAge: 0,
  };
  navigator.geolocation.getCurrentPosition(success, error, options);

  // Tiempo en ubicacion
  async function getWeatherData(apiUrl: string) {
    try {
      const response = await fetch(apiUrl);

      if (!response.ok) {
        throw new Error(`Error al obtener los datos: ${response.statusText}`);
      }

      const data = await response.json();

      updateHtmlElements(data.name, data.main.temp);
    } catch (error) {
      console.error("Error:", error instanceof Error ? error.message : error);
    }
  }

  function updateHtmlElements(ciudadName: string, temperatura: any) {
    const ciudadElement = document.getElementById("ciudad");
    const tempElement = document.getElementById("temperatura");

    if (ciudadElement) {
      ciudadElement.innerText = `${ciudadName}`;
    }
    if (tempElement) {
      tempElement.innerText = `${temperatura.toFixed(1)}`;
    }
  }
</script>
