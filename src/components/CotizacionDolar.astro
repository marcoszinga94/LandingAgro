<div class="flex flex-row justify-center gap-12 text-green-950 border-y-2 border-green-700 mt-2">
  <p class="flex font-medium text-center text-sm content-center" id="DolarOficial"></p>
  <p class="flex font-medium text-center text-sm content-center" id="DolarBlue"></p>
  <p class="flex font-medium text-center text-sm content-center" id="DolarBolsa"></p>
</div>

<script>
  const apiUrl = "https://dolarapi.com/v1/dolares";

  async function getDolarPrice(apiUrl) {
    try {
      const response = await fetch(apiUrl);

      if (!response.ok) {
        throw new Error(`Error al obtener los datos: ${response.statusText}`);
      }

      const data = await response.json();
      console.log(data);

      //OFICIAL
      const precioCompraOficial = data[0].compra;
      const precioVentaOficial = data[0].venta;
      const nombreOficial = data[0].nombre;
      const monedaOficial = data[0].moneda;

      //BLUE
      const precioCompraBlue = data[1].compra;
      const precioVentaBlue = data[1].venta;
      const nombreBlue = data[1].nombre;
      const monedaBlue = data[1].moneda;

      //BOLSA
      const precioCompraBolsa = data[2].compra;
      const precioVentaBolsa = data[2].venta;
      const nombreBolsa = data[2].nombre;
      const monedaBolsa = data[2].moneda;

      updateHtmlElements(
        precioCompraOficial,
        precioVentaOficial,
        nombreOficial,
        monedaOficial,
        monedaBlue,
        nombreBlue,
        precioCompraBlue,
        precioVentaBlue,
        monedaBolsa,
        nombreBolsa,
        precioCompraBolsa,
        precioVentaBolsa
      );
    } catch (error) {
      console.error("Error:", error.message);
    }
  }

  function updateHtmlElements(
    precioCompraOficial,
    precioVentaOficial,
    nombreOficial,
    monedaOficial,
    monedaBlue,
    nombreBlue,
    precioCompraBlue,
    precioVentaBlue,
    monedaBolsa,
    nombreBolsa,
    precioCompraBolsa,
    precioVentaBolsa
  ) {
    const dolarOficialElement = document.getElementById("DolarOficial");

    if (dolarOficialElement) {
      dolarOficialElement.innerText = `${monedaOficial} ${nombreOficial}: $${precioCompraOficial} / $${precioVentaOficial}`;
    }

    const dolarBlueElement = document.getElementById("DolarBlue");

    if (dolarBlueElement) {
      dolarBlueElement.innerText = `${monedaBlue} ${nombreBlue}: $${precioCompraBlue} / $${precioVentaBlue}`;
    }
    const dolarBolsaElement = document.getElementById("DolarBolsa");

    if (dolarBolsaElement) {
      dolarBolsaElement.innerText = `${monedaBolsa} ${nombreBolsa}: $${precioCompraBolsa} / $${precioVentaBolsa}`;
    }
  }

  getDolarPrice(apiUrl);
</script>
