---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>El Socorro SRL - Empresa dedicada al Agro</title>
    <meta
      name="description"
      content="Somos El Socorro SRL una empresa dedicada al servicio del campo"
    />

    <script
      is:inline
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-EJ2LPSCQH6"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-EJ2LPSCQH6");
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="El Socorro SRL - Empresa dedicada al Agro"
    />
    <meta
      property="og:description"
      content="Somos El Socorro SRL una empresa dedicada al servicio del campo"
    />
    <meta property="og:image" content="/Images/og-image-socorro.png" />
    <meta property="og:url" content="https://elsocorrosrl.com/" />
    <meta
      name="keywords"
      content="agricultura, campo, agro, El Socorro, servicio agrícola"
    />

    <meta name="author" content="Marcos Federico Zingaretti" />
    <meta name="robots" content="index, follow" />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    overflow-x: hidden;
  }

  section[id] {
    scroll-margin-top: 100px;
  }

  @font-face {
    font-family: "Wremena";
    src: url("/Fonts/Wremena.otf");
  }

  @font-face {
    font-family: "Mori";
    src: url("/Fonts/Mori.otf");
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: "Wremena";
  }

  p {
    font-family: "Mori";
  }
</style>
